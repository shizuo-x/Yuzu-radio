# .env.example

# --- Core Bot Settings ---
DISCORD_TOKEN=Your_Discord_Bot_Token_Here

# --- Radio Station Configuration ---
# If you have a PocketBase instance for managing radio stations, enter the URL here.
# If this is left empty, the bot will use the 'stations.json' file instead.
POCKETBASE_URL="Your_PocketBase_URL_Here"

# --- Translation Service ---
# Optional: URL for a self-hosted LibreTranslate instance.
LIBRETRANSLATE_API_URL="Your_LibreTranslate_API_URL_Here"

# --- AI Assistant Configuration ---

# Set this to "gemini" or "deepseek" to choose your provider. Defaults to gemini if not set.
AI_PROVIDER="deepseek"

# == Google Gemini Settings ==
# Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=Your_Gemini_API_Key_Here
# The Gemini model to use. 'models/gemini-1.5-flash-latest' is a good, fast choice.
GEMINI_MODEL="models/gemini-2.5-flash-preview-05-20"

# == DeepSeek Settings ==
# Get from https://platform.deepseek.com/
DEEPSEEK_API_KEY=Your_DeepSeek_API_Key_Here
# The DeepSeek model to use. 'deepseek-chat' is for general conversation. 'deepseek-coder' is for code.
DEEPSEEK_MODEL="deepseek-reasoner"